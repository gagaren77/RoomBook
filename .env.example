# Database
DATABASE_URL="postgresql://user:password@localhost:5432/school_booking"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret" # generate-with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# Okta SSO
OKTA_CLIENT_ID="your-okta-client-id"
OKTA_CLIENT_SECRET="your-okta-client-secret"
OKTA_ISSUER="https://your-org.okta.com"

# Microsoft Graph API (for Outlook calendar invites)
AZURE_AD_CLIENT_ID="your-azure-app-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-app-client-secret"
AZURE_AD_TENANT_ID="your-azure-tenant-id"

# Email (SMTP fallback for .ics invites - use your Office 365 SMTP)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="noreply@your-school.edu"
SMTP_PASSWORD="your-smtp-app-password"
SMTP_FROM="School Booking System <noreply@your-school.edu>"

# App
APP_NAME="School Room Booking"
APP_URL="http://localhost:3000"
